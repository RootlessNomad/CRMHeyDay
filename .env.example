# HeyDay CRM — Environment variables
# Copy to .env (dev) and complete. Never commit the real .env.
# Levels reference (see design/architecture.md > Credential Level Mapping):
#   Level 1 — non-sensitive runtime config
#   Level 2 — deployment secrets (EasyPanel env)
#   Level 3 — per-integration secrets managed from admin panel (cifrados en DB)

# ---------- Level 1 — runtime config ----------
APP_ENV=development                     # development | staging | production
LOG_LEVEL=info                          # debug | info | warn | error
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
API_PORT=3001
WEB_PORT=3000
TZ=Europe/Madrid

# ---------- Level 2 — deployment secrets ----------
# Postgres
DATABASE_URL=postgresql://heyday:heyday@localhost:5432/heyday_crm?schema=public

# Redis (BullMQ + rate limit)
REDIS_URL=redis://localhost:6379
# Prefijo de keys de BullMQ (permite aislar entornos que comparten Redis)
QUEUE_PREFIX=heyday
# Concurrencia por defecto de cada worker de BullMQ
WORKER_CONCURRENCY=5

# JWT — 32+ bytes recomendados, generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# Credential vault master key — 32 bytes base64 (AES-256-GCM)
# Generar con: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=

# Public URL of the web app (CORS + cookie domain)
APP_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# Anthropic — clave por defecto del proveedor de IA (puede sobrescribirse via vault)
ANTHROPIC_API_KEY=

# Modelos Claude por feature (defaults si no se sobrescriben en DB)
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_PREMIUM=claude-opus-4-7

# Seed passwords para los dos usuarios iniciales (solo desarrollo/seed; en prod usar reset)
SEED_ALEX_EMAIL=alex@heyday.studio
SEED_ALEX_PASSWORD=
SEED_ALBA_EMAIL=alba@heyday.studio
SEED_ALBA_PASSWORD=

# Diagnostics
PRISMA_LOG_QUERIES=false

# ---------- Level 3 — admin panel (NUNCA se leen aquí; solo de referencia) ----------
# Google Places, PageSpeed, n8n webhook secret, Airtable PAT, Google OAuth,
# Meta Graph, LinkedIn API, WhatsApp API, Apollo/Clearbit/etc.
# → se añaden desde /admin/credentials y se cifran en DB.
