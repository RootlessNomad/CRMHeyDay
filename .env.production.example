# HeyDay CRM — Variables de entorno para PRODUCCIÓN
# VPS: 46.202.131.13 | Dominio: crm.estudioheyday.com
#
# Copia este fichero a .env.production y rellena TODOS los valores.
# NUNCA subas .env.production al repositorio.
#
# Generar secretos:
#   JWT_ACCESS_SECRET:     openssl rand -base64 48
#   JWT_REFRESH_SECRET:    openssl rand -base64 48
#   CREDENTIAL_MASTER_KEY: openssl rand -base64 32
#   POSTGRES_PASSWORD:     openssl rand -base64 24

# ─── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info
TZ=Europe/Madrid

# ─── Servidor ─────────────────────────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000

# ─── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<CAMBIAR>
DATABASE_URL=postgresql://postgres:<CAMBIAR>@heyday-db:5432/heyday_crm?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://heyday-redis:6379
QUEUE_PREFIX=heyday
WORKER_CONCURRENCY=3

# ─── JWT (≥32 bytes, base64) ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=<CAMBIAR>
JWT_REFRESH_SECRET=<CAMBIAR>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# ─── Credential Vault (32 bytes base64 exacto) ────────────────────────────────
CREDENTIAL_MASTER_KEY=<CAMBIAR>

# ─── IA ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-<CAMBIAR>
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_PREMIUM=claude-opus-4-7

# ─── Web / Cookies ────────────────────────────────────────────────────────────
APP_URL=https://crm.estudioheyday.com
COOKIE_DOMAIN=crm.estudioheyday.com
NEXT_PUBLIC_API_URL=https://crm.estudioheyday.com/api/v1
NEXT_PUBLIC_APP_NAME=HeyDay CRM

# ─── Seed inicial (solo para el job de seed, no para el servidor) ─────────────
SEED_ALEX_PASSWORD=<CAMBIAR_min12chars>
SEED_ALBA_PASSWORD=<CAMBIAR_min12chars>
