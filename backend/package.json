{
  "name": "@heyday/backend",
  "version": "0.1.0",
  "private": true,
  "description": "HeyDay CRM backend — API Fastify + worker BullMQ",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/api/server.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker/main.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/api/server.js",
    "start:worker": "node --env-file=.env dist/worker/main.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir src",
    "test:integration": "vitest run --dir tests/integration",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "seed:demo": "tsx --env-file=.env prisma/seed.ts && tsx --env-file=.env prisma/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@fastify/cookie": "10.0.1",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@fastify/sensible": "6.0.1",
    "@heyday/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "bullmq": "5.21.2",
    "fastify": "5.1.0",
    "fastify-plugin": "5.0.1",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.14.15",
    "prisma": "5.22.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
